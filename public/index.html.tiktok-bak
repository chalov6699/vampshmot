<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Vamp Shmot</title>
<link rel="stylesheet" href="style.css">
</head>
<body>
<div id="preloader"><div class="preloader-content"><span id="preloader-title"></span><span id="preloader-heart">❤️</span></div></div>
</div>






        
    </div>
</div>


        
        
    </div>
</div>


</div>



<!-- Уведомления -->
<div id="toast-container"></div>

<!-- Страница "Заказ оформлен" -->
<section class="success-page" id="success-view">
    <div class="success-box">
        <div class="success-icon">
            <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="#2d7a2d" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <path d="M8 12l3 3 5-6"/>
            </svg>
        </div>
        <h2>Заказ оформлен!</h2>
        <p id="success-text">Мы свяжемся с вами для подтверждения.</p>
        <button class="btn" onclick="showCatalog()">Вернуться в каталог</button>
    </div>
</section>

<header>
    <div class="logo" onclick="showCatalog()">
        <img src="img/vamp.png" alt="Logo">
    </div>
    <nav>
        <ul>
            <li><a onclick="showCatalog()">Каталог</a></li>
            <li><a onclick="showBrands()">Бренды</a></li>
            <li><a onclick="showContacts()">Контакты</a></li>
        </ul>
    </nav>
    <div class="header-right">
        <div class="cart-icon" onclick="showCart()">🛒<span class="cart-count" id="cart-count">0</span></div>
        <div id="user-area"></div>
    </div>
</header>

<!-- ГЛАВНАЯ -->
<main id="main-view">
    <section class="hero">
        <div class="hero-slider" id="hero-slider">
            <button class="slider-arrow slider-prev" onclick="prevSlide()">‹</button>
            <button class="slider-arrow slider-next" onclick="nextSlide()">›</button>
            <div class="slider-dots" id="slider-dots"></div>
        </div>
        <div class="hero-content">
            <h1>Vamp Shmot</h1>
            <p>Одежда от независимых дизайнеров. Уникальные вещи, честные цены, доставка по всей стране.</p>
            <button class="btn" onclick="document.querySelector('.catalog').scrollIntoView({behavior:'smooth'})">Смотреть коллекцию</button>
        </div>
    </section>

    <section class="catalog" id="catalog-section">
        <h2>Коллекция</h2>

        <!-- Фильтры -->
        <div class="filters-bar">
            <div class="filter-item">
                <label>Категория:</label>
                <select id="category-select" onchange="onCategoryChange(this.value)">
                    <option value="">Все категории</option>
                </select>
            </div>
            <div class="filter-item">
                <label>Сортировка:</label>
                <select id="sort-select" onchange="onSortChange(this.value)">
                    <option value="recommended">По рекомендациям</option>
                    <option value="cheap">Сначала дешёвые</option>
                    <option value="expensive">Сначала дорогие</option>
                    <option value="new">Новинки</option>
                    <option value="discount">Со скидкой</option>
                </select>
            </div>
            <button class="btn btn-small" onclick="resetFilters()">Сбросить</button>
        </div>

        <div class="filter-info" id="filter-info"></div>

        <div class="grid" id="product-grid"></div>
    </section>
</main>

<!-- СТРАНИЦА ТОВАРА -->
<section class="product-page" id="product-view">
    <div class="back-btn" onclick="showCatalog()">← Назад в каталог</div>
    <div class="product-layout">
        <div>
            <div class="product-gallery">
                <img id="pv-image" class="product-image" src="" alt="">
                <button class="gallery-arrow gallery-prev" onclick="prevProductImage()">‹</button>
                <button class="gallery-arrow gallery-next" onclick="nextProductImage()">›</button>
            </div>
            <div class="product-thumbs" id="pv-thumbs"></div>
        </div>
        <div class="product-info">
            <div class="product-brand" id="pv-brand"></div>
            <h1 id="pv-name"></h1>
            <div class="product-price" id="pv-price"></div>
            <div class="accordion" id="pv-accordion">
                <div class="accordion-item" data-key="description">
                    <button class="accordion-head" onclick="toggleAccordion(this)">
                        <span>Описание</span>
                        <svg class="acc-chev" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                    </button>
                    <div class="accordion-body"><div class="accordion-inner" id="pv-description"></div></div>
                </div>
                <div class="accordion-item" data-key="specs">
                    <button class="accordion-head" onclick="toggleAccordion(this)">
                        <span>Характеристики</span>
                        <svg class="acc-chev" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                    </button>
                    <div class="accordion-body"><div class="accordion-inner" id="pv-specs">—</div></div>
                </div>
                <div class="accordion-item" data-key="delivery">
                    <button class="accordion-head" onclick="toggleAccordion(this)">
                        <span>Доставка и оплата</span>
                        <svg class="acc-chev" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                    </button>
                    <div class="accordion-body"><div class="accordion-inner">
                        Доставка по России — 3–7 дней. Оплата картой, СБП или при получении.
                    </div></div>
                </div>
                <div class="accordion-item" data-key="warranty">
                    <button class="accordion-head" onclick="toggleAccordion(this)">
                        <span>Гарантии</span>
                        <svg class="acc-chev" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                    </button>
                    <div class="accordion-body"><div class="accordion-inner">
                        Обмен и возврат в течение 14 дней. Все товары проверены.
                    </div></div>
                </div>
            </div>
            <div class="option-group"><label>Размер</label><div class="sizes" id="pv-sizes"></div></div>
            <div class="option-group"><label>Количество</label>
                <div class="quantity">
                    <button onclick="changeQty(-1)">−</button>
                    <span id="pv-qty">1</span>
                    <button onclick="changeQty(1)">+</button>
                </div>
            </div>
            <button class="add-to-cart-btn" onclick="addCurrentToCart()">Добавить в корзину</button>
            <button class="reserve-btn" onclick="reserveCurrentProduct()">Забронировать</button>
        </div>
    </div>

    <!-- ОТЗЫВЫ -->
    <div class="reviews-block" id="pv-reviews">
        <div class="reviews-head">
            <h3>Отзывы <span id="rv-count">(0)</span></h3>
            <div class="reviews-rating" id="rv-avg"></div>
        </div>
        <form class="review-form" id="review-form" onsubmit="submitReview(event)">
            <div class="review-stars" id="review-stars">
                <span data-r="1">★</span><span data-r="2">★</span><span data-r="3">★</span><span data-r="4">★</span><span data-r="5">★</span>
            </div>
            <textarea id="review-text" placeholder="Напишите отзыв о товаре..." rows="3"></textarea>
            <button type="submit" class="btn">Отправить отзыв</button>
            <div class="review-form-note" id="review-note">Войдите, чтобы оставить отзыв</div>
        </form>
        <div class="reviews-list" id="reviews-list"></div>
    </div>

    <!-- ПОХОЖИЕ ТОВАРЫ -->
    <div class="related-block" id="pv-related">
        <h3>Похожие товары</h3>
        <div class="related-wrap">
            <button class="related-arrow related-prev" onclick="scrollRelated(-1)">‹</button>
            <div class="related-track" id="related-track"></div>
            <button class="related-arrow related-next" onclick="scrollRelated(1)">›</button>
        </div>
    </div>
</section>

<!-- БРЕНДЫ -->
<section class="brands-page" id="brands-view">
    <div class="back-btn" onclick="showCatalog()">← Назад в каталог</div>
    <h2>Бренды</h2>
    <div class="brands-grid" id="brands-grid"></div>
</section>

<!-- СТРАНИЦА БРЕНДА -->
<section class="brand-page" id="brand-view">
    <div class="back-btn" onclick="showBrands()">← Назад к брендам</div>
    <div class="brand-header">
        <img id="bv-logo" src="" alt="" class="brand-logo">
        <div>
            <h2 id="bv-name"></h2>
            <p id="bv-desc"></p>
        </div>
    </div>
    <h3 style="margin:30px 0 20px;">Товары бренда</h3>
    <div class="grid" id="brand-products"></div>
</section>

<!-- КОРЗИНА -->
<section class="cart-page" id="cart-view">
    <div class="back-btn" onclick="showCatalog()">← Назад в каталог</div>
    <h2>Корзина</h2>
    <div id="cart-content"></div>
</section>

<!-- МОИ ЗАКАЗЫ -->
<section class="cart-page my-orders-page" id="my-orders-view">
    <div class="back-btn" onclick="showCatalog()">← Назад в каталог</div>
    <h2 class="my-orders-title">Мои заказы</h2>
    <div id="my-orders-content" class="my-orders-list"></div>
</section>

<!-- КОНТАКТЫ -->
<section class="contacts-page" id="contacts-view">
    <div class="back-btn" onclick="showCatalog()">← Назад в каталог</div>
    <h2>Контакты</h2>
    <div class="contacts-box" id="contacts-box"></div>
</section>

<!-- АДМИНКА -->
<section class="admin-page" id="admin-view">
    <div class="back-btn" onclick="showCatalog()">← Назад в магазин</div>
    <h2>Админ-панель</h2>
    <div class="admin-tabs">
        <button class="admin-tab active" onclick="switchAdminTab('products',this)">Товары</button>
        <button class="admin-tab" onclick="switchAdminTab('add',this)">Добавить товар</button>
        <button class="admin-tab" onclick="switchAdminTab('brands',this)">Бренды</button>
        <button class="admin-tab" onclick="switchAdminTab('badges',this)">Бейджи</button>
        <button class="admin-tab" onclick="switchAdminTab('slider',this)">Слайдер</button>
        <button class="admin-tab" onclick="switchAdminTab('orders',this)">Заказы</button>
        <button class="admin-tab" onclick="switchAdminTab('contacts',this)">Контакты</button>
        <button class="admin-tab" onclick="switchAdminTab('settings',this)">Настройки</button>
        <button class="admin-tab" onclick="switchAdminTab('users',this)">Пользователи</button>
        <button class="admin-tab" onclick="switchAdminTab('chats',this)">Чаты <span id="admin-chat-badge" style="display:none;background:#8b0000;color:#fff;border-radius:999px;padding:1px 7px;font-size:11px;margin-left:4px;"></span></button>
    </div>

    <div class="admin-section active" id="admin-products">
        <table class="admin-table">
            <thead><tr><th>Фото</th><th>Название</th><th>Категория</th><th>Бренд</th><th>Цена</th><th>Скидка</th><th>Действия</th></tr></thead>
            <tbody id="admin-products-body"></tbody>
        </table>
    </div>

    <div class="admin-section" id="admin-add">
        <div class="admin-form">
            <h3 id="form-title">Новый товар</h3>
            <input type="hidden" id="edit-id">
            <div class="form-group"><label>Название</label><input type="text" id="f-name"></div>
            <div class="form-row">
                <div class="form-group"><label>Цена (₽)</label><input type="number" id="f-price"></div>
                <div class="form-group"><label>Скидка (%)</label><input type="number" id="f-discount" min="0" max="90" value="0"></div>
            </div>
            <div class="form-group">
                <label>Артикул <span style="color:#999;font-weight:normal;">(оставьте пустым — сгенерируется автоматически)</span></label>
                <input type="text" id="f-sku" placeholder="VAMP-0001">
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>Бренд</label>
                    <select id="f-brand"><option value="">— без бренда —</option></select>
                </div>
                <div class="form-group">
                    <label>Категория</label>
                    <select id="f-category"><option value="">— без категории —</option></select>
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>Остаток (шт.)</label>
                    <input type="number" id="f-stock" min="0" value="0">
                </div>
                <div class="form-group">
                    <label>Статус наличия</label>
                    <select id="f-stock-status">
                        <option value="in_stock">В наличии</option>
                        <option value="out_of_stock">Нет в наличии</option>
                        <option value="coming_soon">Скоро в наличии</option>
                    </select>
                </div>
            </div>
            <div class="form-group">
                <label>Бейджи на карточке</label>
                <div class="badges-checkboxes" id="f-badges"></div>
            </div>
            <div class="form-group"><label>Размеры через запятую</label><input type="text" id="f-sizes" placeholder="S, M, L, XL"></div>
            <div class="form-group">
                <label>Остатки по размерам (0 = нет в наличии)</label>
                <div id="f-stock-by-size" class="stock-by-size-grid">
                    <span style="color:#888;font-size:12px;">Сначала укажите размеры выше</span>
                </div>
                <small style="color:#888;font-size:12px;">Обновляется автоматически при вводе размеров.</small>
            </div>
            <div class="form-group">
                <label>Фото товара</label>
                <div class="upload-zone" id="upload-zone">
                    <div id="upload-placeholder">
                        <div style="font-size:32px;">📷</div>
                        <div>Нажмите или перетащите фото</div>
                    </div>
                </div>
                <input type="file" id="f-file" accept="image/*" multiple style="display:none;">
                <div class="form-row" style="margin-top:12px;">
                    <div class="form-group" style="margin-bottom:0;"><label>или URL</label><input type="text" id="f-img-url"></div>
                    <div class="form-group" style="margin-bottom:0;"><label>&nbsp;</label><button type="button" class="btn" onclick="addUrlPhoto()">Добавить URL</button></div>
                </div>
                <div class="slides-list" id="product-photos-list" style="margin-top:15px;"></div>
            </div>
            <div class="form-group">
                <label>Характеристики</label>
                <div id="f-specs-list" class="specs-list"></div>
                <button type="button" class="btn btn-small" onclick="addSpecRow()" style="margin-top:8px;">+ Добавить характеристику</button>
            </div>
            <div class="form-group"><label>Описание</label><textarea id="f-desc"></textarea></div>
            <button class="btn" onclick="saveProduct()">Сохранить</button>
            <button class="btn btn-danger" onclick="resetProductForm()" style="margin-left:10px;">Отмена</button>
        </div>
    </div>

    <div class="admin-section" id="admin-brands">
        <div class="admin-form" style="max-width:100%;">
            <h3>Добавить бренд</h3>
            <div class="form-row">
                <div class="form-group"><label>Название</label><input type="text" id="b-name"></div>
                <div class="form-group"><label>Описание</label><input type="text" id="b-desc"></div>
            </div>
            <div class="form-group">
                <label>Логотип (файл)</label>
                <div class="upload-zone" id="brand-upload-zone" style="min-height:120px;">
                    <div id="brand-upload-placeholder">
                        <div style="font-size:24px;">🏷️</div>
                        <div>Нажмите или перетащите логотип</div>
                    </div>
                    <img id="brand-upload-preview" style="display:none; max-height:120px;" alt="">
                </div>
                <input type="file" id="brand-logo-file" accept="image/*" style="display:none;">
                <div class="form-group" style="margin-top:10px;"><label>или URL логотипа</label><input type="text" id="b-logo-url"></div>
            </div>
            <button class="btn" onclick="saveBrand()">Добавить бренд</button>
            <h3 style="margin-top:40px;">Список брендов</h3>
            <table class="admin-table">
                <thead><tr><th>Логотип</th><th>Название</th><th>Описание</th><th>Действия</th></tr></thead>
                <tbody id="admin-brands-body"></tbody>
            </table>
        </div>
    </div>

    <div class="admin-section" id="admin-badges">
        <div class="admin-form" style="max-width:100%;">
            <h3>Добавить бейдж</h3>
            <div class="form-row">
                <div class="form-group"><label>Код (латиницей, уникальный)</label><input type="text" id="bd-code" placeholder="hit"></div>
                <div class="form-group"><label>Название</label><input type="text" id="bd-label" placeholder="Хит продаж"></div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>Иконка</label>
                    <input type="hidden" id="bd-icon" value="">
                    <div class="badge-icon-grid" id="badge-icon-grid"></div>
                </div>
                <div class="form-group"><label>Порядок сортировки</label><input type="number" id="bd-sort" value="0"></div>
            </div>
            <div class="form-row">
                <div class="form-group"><label>Цвет фона</label><input type="color" id="bd-color" value="#111111"></div>
                <div class="form-group"><label>Цвет текста</label><input type="color" id="bd-text-color" value="#ffffff"></div>
            </div>
            <div class="form-group">
                <label><input type="checkbox" id="bd-auto"> Автоматический (показывать при выполнении условия)</label>
            </div>
            <button class="btn" onclick="saveBadge()">Добавить бейдж</button>

            <h3 style="margin-top:40px;">Список бейджей</h3>
            <table class="admin-table">
                <thead><tr><th>Иконка</th><th>Название</th><th>Код</th><th>Цвета</th><th>Авто</th><th>Порядок</th><th>Действия</th></tr></thead>
                <tbody id="admin-badges-body"></tbody>
            </table>
        </div>
    </div>
    <div class="admin-section" id="admin-slider">
        <div class="admin-form" style="max-width:100%;">
            <h3>Слайды на главной</h3>
            <div class="form-group">
                <label>Добавить слайд</label>
                <div class="upload-zone" id="slide-upload-zone" style="min-height:150px;">
                    <div id="slide-upload-placeholder"><div style="font-size:28px;">🖼️</div><div>Нажмите или перетащите фото</div></div>
                    <img id="slide-upload-preview" style="display:none; max-height:200px;" alt="">
                </div>
                <input type="file" id="slide-file" accept="image/*" style="display:none;">
            </div>
            <div class="form-group"><label>или URL</label><input type="text" id="slide-url"></div>
            <button class="btn" onclick="addSlide()">Добавить слайд</button>
            <h3 style="margin-top:40px;">Текущие слайды</h3>
            <div id="slides-list" class="slides-list"></div>
        </div>
    </div>

    <div class="admin-section" id="admin-orders">
        <table class="admin-table">
            <thead><tr><th>ID</th><th>Клиент</th><th>Телефон</th><th>Адрес</th><th>Товары</th><th>Сумма</th><th>Оплата</th><th>Статус</th></tr></thead>
            <tbody id="admin-orders-body"></tbody>
        </table>
    </div>

    <div class="admin-section" id="admin-contacts">
        <div class="admin-form">
            <h3>Контакты</h3>
            <div class="form-group"><label>Телефон</label><input type="text" id="c-phone"></div>
            <div class="form-group"><label>Email</label><input type="text" id="c-email"></div>
            <div class="form-group"><label>Адрес</label><input type="text" id="c-address"></div>
            <div class="form-row">
                <div class="form-group"><label>Instagram</label><input type="text" id="c-instagram"></div>
                <div class="form-group"><label>Telegram</label><input type="text" id="c-telegram"></div>
            </div>
            <div class="form-row">
                <div class="form-group"><label>WhatsApp</label><input type="text" id="c-whatsapp"></div>
                <div class="form-group"><label>Часы работы</label><input type="text" id="c-hours"></div>
            </div>
            <button class="btn" onclick="saveContacts()">Сохранить</button>
        </div>
    </div>


    <div class="admin-section" id="admin-settings">
        <div class="admin-form" style="max-width: 100%;">
            <h3>Настройки магазина</h3>

            <div class="setting-row">
                <div>
                    <div class="setting-title">Бронирование товаров</div>
                    <div class="setting-desc">Если включено — на странице товара появится кнопка «Забронировать». Покупатели смогут забронировать товар, а вы — сообщить, когда он будет в наличии.</div>
                </div>
                <label class="switch">
                    <input type="checkbox" id="reserve-toggle" onchange="toggleReserve(this.checked)">
                    <span class="slider"></span>
                </label>
            </div>

            <div class="setting-status" id="reserve-status">Загрузка...</div>
        </div>
    </div>

    <div class="admin-section" id="admin-users">
        <table class="admin-table">
            <thead><tr><th>ID</th><th>Имя</th><th>Email</th><th>Роль</th><th>Дата</th></tr></thead>
            <tbody id="admin-users-body"></tbody>
        </table>
    </div>

    
</section>

<!-- МОДАЛЬНОЕ ОКНО -->
<div class="modal-overlay" id="auth-modal">
    <div class="modal">
        <button class="modal-close" onclick="closeAuthModal()">×</button>
        <h2 id="auth-title">Вход</h2>
        <div id="login-form">
            <div class="form-group"><label>Email или логин</label><input type="text" id="login-email" placeholder="Email или логин"></div>
            <div class="form-group"><label>Пароль</label><input type="password" id="login-password"></div>
            <div class="error-msg" id="login-error"></div>
            <button class="btn" onclick="doLogin()">Войти</button>
            <div class="switch-form">Нет аккаунта? <a onclick="switchAuthForm('register')">Регистрация</a></div>
        </div>
        <div id="register-form" style="display:none;">
            <div class="form-group"><label>Имя</label><input type="text" id="reg-name"></div>
            <div class="form-group"><label>Email</label><input type="email" id="reg-email"></div>
            <div class="form-group"><label>Пароль (мин. 6)</label><input type="password" id="reg-password"></div>
            <div class="error-msg" id="reg-error"></div>
            <button class="btn" onclick="doRegister()">Зарегистрироваться</button>
            <div class="switch-form">Уже есть аккаунт? <a onclick="switchAuthForm('login')">Войти</a></div>
        </div>
    </div>
</div>


<!-- ЧАТЫ (вынесены из admin-page для полной ширины) -->
<div class="admin-section" id="admin-chats">
        <div class="admin-chats-wrap">
            <div class="admin-chats-list" id="admin-chats-list">
                <div class="admin-chats-list__head">
                    <h3>Диалоги</h3>
                    <button class="btn btn-small" onclick="loadAdminChats()">↻</button>
                </div>
                <div id="admin-chats-list-body"></div>
            </div>
            <div class="admin-chats-room" id="admin-chats-room">
                <div class="admin-chats-room__empty" id="admin-chats-empty">
                    <div style="font-size:56px;opacity:.3;">💬</div>
                    <p>Выберите диалог слева</p>
                </div>
                <div class="admin-chats-room__active" id="admin-chats-active" style="display:none;">
                    <div class="admin-chats-room__head">
                        <div>
                            <div class="admin-chats-room__name" id="admin-chat-name">—</div>
                            <div class="admin-chats-room__status" id="admin-chat-status">клиент</div>
                        </div>
                    </div>
                    <div class="admin-chats-room__body" id="admin-chat-body"></div>
                    <form class="admin-chats-room__form" id="admin-chat-form" autocomplete="off">
                        <input type="text" id="admin-chat-input" placeholder="Введите сообщение..." autocomplete="off">
                        <button type="submit" aria-label="Отправить">
                            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

<footer class="site-footer">
    <div class="footer-inner">
        <div class="footer-col footer-col--brand">
            <div class="footer-logo">VAMP SHMOT</div>
            <p class="footer-desc">Кроссовки, одежда и аксессуары в Мариуполе. Бесплатная доставка по городу.</p>
            <div class="footer-contacts">
                <a href="tel:+79496143546">📞 +7 (949) 614-35-46</a>
                <a href="https://t.me/yulya_lavrinenko" target="_blank" rel="noopener">✉️ @yulya_lavrinenko</a>
                <span>📍 Мариуполь, Центральный рынок</span>
            </div>
        </div>
        <div class="footer-col">
            <h4>Покупателям</h4>
            <ul>
                <li><a onclick="openLegal('delivery')">Доставка и оплата</a></li>
                <li><a onclick="openLegal('return')">Возврат и обмен</a></li>
                <li><a onclick="showContacts()">Контакты</a></li>
                <li><a onclick="openLegal('privacy')">Политика конфиденциальности</a></li>
                <li><a onclick="openLegal('terms')">Пользовательское соглашение</a></li>
            </ul>
        </div>
        <div class="footer-col">
            <h4>Мы в сети</h4>
            <div class="footer-social">
                <a href="https://t.me/vamp_shmotmariupol" target="_blank" rel="noopener" class="soc-btn soc-btn--tg" aria-label="Telegram">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M9.78 18.65l.28-4.23 7.68-6.92c.34-.31-.07-.46-.52-.19L7.74 13.3 3.64 12c-.88-.25-.89-.86.2-1.3l15.97-6.16c.73-.33 1.43.18 1.15 1.3l-2.72 12.81c-.19.91-.74 1.13-1.5.71L12.6 16.3l-1.99 1.93c-.23.23-.42.42-.83.42z"/></svg>
                    <span>Telegram</span>
                </a>
                <a href="https://t.me/vamp_shmotmariupol" target="_blank" rel="noopener" class="soc-btn soc-btn--tt" aria-label="TikTok">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z"/></svg>
                    <span>TikTok</span>
                </a>
            </div>
        </div>
    </div>
    <div class="footer-bottom">
        <span>© 2026 Vamp Shmot. Все права защищены.</span>
        <div class="footer-bottom-links">
            <a onclick="openLegal('privacy')">Политика конфиденциальности</a>
            <a onclick="openLegal('terms')">Пользовательское соглашение</a>
            <a onclick="openLegal('return')">Правила возврата</a>
        </div>
    </div>
</footer>

<!-- Модалка юридических текстов -->
<div class="legal-modal" id="legal-modal">
    <div class="legal-modal__backdrop" onclick="closeLegal()"></div>
    <div class="legal-modal__content">
        <button class="legal-modal__close" onclick="closeLegal()">✕</button>
        <h2 id="legal-title"></h2>
        <div id="legal-body"></div>
    </div>
</div>

<!-- Плавающий чат с продавцом -->
<div class="chat-widget" id="chat-widget">
    <button class="chat-launcher" id="chat-launcher" onclick="toggleChat()" aria-label="Чат с продавцом">
        <svg class="chat-ico chat-ico--open" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        <svg class="chat-ico chat-ico--close" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none;"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        <span class="chat-unread" id="chat-unread" style="display:none;">0</span>
    </button>
    <div class="chat-window" id="chat-window">
        <div class="chat-head">
            <div>
                <strong>Чат с продавцом</strong>
                <div class="chat-status" id="chat-status">онлайн</div>
            </div>
            <button class="chat-head-close" onclick="toggleChat(false)">✕</button>
        </div>
        <div class="chat-body" id="chat-body"></div>
        <form class="chat-form" id="chat-form" autocomplete="off">
            <input type="text" id="chat-input" placeholder="Напишите сообщение..." autocomplete="off">
            <button type="submit" aria-label="Отправить">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
            </button>
        </form>
        <div class="chat-auth-note" id="chat-auth-note">Войдите, чтобы написать продавцу</div>
    </div>
</div>

<script src="script.js"></script>

<!-- === BURGER FILTERS (start) === -->
<button class="burger" id="burgerBtn" aria-label="Фильтры" aria-expanded="false">
  <span></span><span></span><span></span>
</button>

<div class="filters-backdrop" id="filtersBackdrop"></div>

<div class="filters-panel" id="filtersPanel">
  <div class="filters-panel__head">
    <span class="filters-panel__title">Фильтры</span>
    <button class="filters-panel__close" id="filtersClose" aria-label="Закрыть">✕</button>
  </div>

  <label class="filters-field">
    <span class="filters-field__label">Категория</span>
    <select id="filterCategory" class="filters-select">
      <option value="">Все категории</option>
    </select>
  </label>

  <label class="filters-field">
    <span class="filters-field__label">Сортировка</span>
    <select id="filterSort" class="filters-select">
      <option value="recommended">По рекомендациям</option>
      <option value="price_asc">Цена: по возрастанию</option>
      <option value="price_desc">Цена: по убыванию</option>
      <option value="new">Сначала новинки</option>
    </select>
  </label>

  <button class="filters-reset" id="filtersReset" type="button">
    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7"/><polyline points="3 4 3 9 8 9"/></svg>
    Сбросить
  </button>
</div>
<!-- === BURGER FILTERS (end) === -->

</body>
</html>