# Секрет для подписи JWT — обязательно замените перед продакшеном
JWT_SECRET=change-me-to-random-string

# Пароль администратора при первой инициализации базы
ADMIN_PASSWORD=admin123

# Порт сайта
PORT=3000

# ЮKassa (необязательно — без этого доступна только оплата при получении)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# --- Telegram-бот (shop-bot.js) ---
# Токен от @BotFather
TELEGRAM_BOT_TOKEN=
# Ваш числовой Telegram ID (узнать у @userinfobot) — только для команды /broadcast
TELEGRAM_ADMIN_ID=
# Базовый URL API сайта для бота. Если бот и сайт на одном сервере — оставить как есть.
SITE_BASE_URL=http://localhost:3000
